---
import { Image } from "astro:assets";
import logo from "../assets/brand/tidco-logo.png";
import { site, whatsappLink, telLink, emailLink, coverageAreas } from "../data/site";

const year = new Date().getFullYear();
---
<!-- Added a comment to test PR -->
<footer class="border-t border-steel-100 bg-steel-950 text-steel-200">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <Image
          src={logo}
          alt={site.name}
          width={160}
          height={93}
          class="h-11 w-auto brightness-0 invert"
        />
        <p class="mt-4 text-sm leading-relaxed text-steel-400">
          {site.tagline} — connecting homes and businesses across North Eastern Kenya.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white">Quick Links</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/packages" class="hover:text-brand-300">Packages</a></li>
          <li><a href="/coverage" class="hover:text-brand-300">Coverage Areas</a></li>
          <li><a href="/about" class="hover:text-brand-300">About Us</a></li>
          <li><a href="/contact" class="hover:text-brand-300">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white">Where We Cover</h3>
        <ul class="mt-4 space-y-2 text-sm">
          {coverageAreas.map((area) => <li>{area.name}</li>)}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white">Get In Touch</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a href={telLink} class="hover:text-brand-300">Call: {site.phone}</a>
          </li>
          <li>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-brand-300">
              WhatsApp: {site.phone}
            </a>
          </li>
          <li>
            <a href={emailLink} class="hover:text-brand-300">{site.email}</a>
          </li>
          <li class="pt-2 text-steel-400">
            {site.paybillLabel}: <span class="font-semibold text-white">{site.paybill}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-steel-800 pt-6 text-xs text-steel-400 sm:flex-row">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>Our staff will never ask you for money directly — all payments go through our official Paybill only.</p>
    </div>
  </div>
</footer>
