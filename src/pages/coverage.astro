---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import coverageGraphic from "../assets/images/coverage-network-graphic.jpg";
import nairobiPresence from "../assets/images/nairobi-presence.jpg";
import garissaPresence from "../assets/images/garissa-local-presence.jpg";
import { coverageAreas, whatsappLink } from "../data/site";
---

<Layout title="Coverage Areas">
  <section class="bg-brand-950 py-20 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold sm:text-5xl">Connecting Cities With Our Reliable Network</h1>
      <p class="mt-5 text-lg text-steel-200">
        Proudly based in Garissa, reaching communities across North Eastern Kenya.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <Image
          src={coverageGraphic}
          alt="Map illustrating Tidco Networks coverage across Wajir, Mandera, Garissa and Marsabit"
          width={1600}
          height={1361}
          class="w-full rounded-2xl"
        />
        <div>
          <h2 class="text-3xl font-extrabold text-steel-900">Where we're live today</h2>
          <p class="mt-4 text-steel-600">
            Our towers and field teams currently serve the following towns, with new sites going up
            as demand grows.
          </p>
          <ul class="mt-8 grid grid-cols-2 gap-4">
            {
              coverageAreas.map((area) => (
                <li class="rounded-xl border border-steel-200 bg-steel-50 px-5 py-4">
                  <p class="text-lg font-bold text-brand-700">{area.name}</p>
                  {area.note && <p class="text-xs font-medium text-steel-500">{area.note}</p>}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm text-steel-500">
            Not sure if we cover your area yet? Reach out and we'll confirm and, where possible, plan
            an expansion.
          </p>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-block rounded-full bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white hover:bg-brand-700"
          >
            Check My Location
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-steel-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold text-steel-900">Beyond the North</h2>
        <p class="mt-4 text-steel-600">
          Our business and fiber solutions also reach clients further afield, including Nairobi.
        </p>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <Image
          src={garissaPresence}
          alt="Tidco Networks branded vehicle in Garissa"
          width={1200}
          height={1600}
          class="h-80 w-full rounded-2xl object-cover"
        />
        <Image
          src={nairobiPresence}
          alt="Tidco Networks branded vehicle in Nairobi"
          width={899}
          height={1600}
          class="h-80 w-full rounded-2xl object-cover"
        />
      </div>
    </div>
  </section>
</Layout>
