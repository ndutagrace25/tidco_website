---
import Layout from "../layouts/Layout.astro";
import PackageCard from "../components/PackageCard.astro";
import { Image } from "astro:assets";

import heroImage from "../assets/images/hero-office-collaboration.jpg";
import coverageGraphic from "../assets/images/coverage-network-graphic.jpg";
import fieldConstruction from "../assets/images/field-construction-site.jpg";
import installTeam from "../assets/images/installation-team-pole.jpg";
import fieldTech from "../assets/images/field-technician-install.jpg";

import { packages, values, buySteps, whatsappLink, telLink, coverageAreas } from "../data/site";

const highlights = [
  {
    title: "Quick Installation",
    detail: "Our field technicians get you online fast, with a professional guided setup.",
  },
  {
    title: "Refundable Deposits",
    detail: "Clear, honest terms — deposits refunded to your M-Pesa once equipment is recovered.",
  },
  {
    title: "24/7 Support",
    detail: "Reach our friendly help desk any time by call or WhatsApp.",
  },
  {
    title: "Skilled Technicians",
    detail: "Experienced installation crews across North Eastern Kenya.",
  },
];
---

<Layout title="Affordable Internet in North Eastern Kenya">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-950">
    <div class="absolute inset-0">
      <Image
        src={heroImage}
        alt="Team collaborating over a fast Tidco internet connection"
        width={1600}
        height={1396}
        class="h-full w-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/90 to-brand-900/60"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="max-w-2xl">
        <p class="inline-block rounded-full bg-brand-500/20 px-4 py-1 text-sm font-semibold text-brand-200 ring-1 ring-inset ring-brand-400/40">
          The Most Affordable Network
        </p>
        <h1 class="mt-6 text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
          Fast, reliable internet for North Eastern Kenya
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-steel-200">
          Tidco Networks connects homes and businesses in Garissa, Wajir, Mandera and Marsabit
          with unlimited internet packages from as little as KES 2,000 a month.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-brand-500 px-8 py-4 text-center text-base font-semibold text-white shadow-lg shadow-brand-900/40 transition-colors hover:bg-brand-400"
          >
            Get Connected on WhatsApp
          </a>
          <a
            href="/packages"
            class="rounded-full border border-white/30 px-8 py-4 text-center text-base font-semibold text-white transition-colors hover:bg-white/10"
          >
            View Packages
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="border-b border-steel-100 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          highlights.map((item) => (
            <div class="text-center sm:text-left">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 sm:mx-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="mt-4 text-base font-bold text-steel-900">{item.title}</h3>
              <p class="mt-2 text-sm text-steel-600">{item.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Packages preview -->
  <section class="bg-steel-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold text-steel-900 sm:text-4xl">Home Internet Packages</h2>
        <p class="mt-4 text-steel-600">
          Unlimited internet, no hidden fees. Pick the speed that fits your household.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-3">
        {packages.map((pkg) => <PackageCard pkg={pkg} />)}
      </div>

      <div class="mt-10 text-center">
        <a href="/packages" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
          See full pricing, billing and business fiber options &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- The Tidco Way -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold text-steel-900 sm:text-4xl">The Tidco Way</h2>
        <p class="mt-4 text-steel-600">What guides how we build and support your connection.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          values.map((value) => (
            <div class="rounded-2xl border border-steel-100 bg-steel-50 p-6">
              <h3 class="text-base font-bold text-brand-700">{value.title}</h3>
              <p class="mt-2 text-sm text-steel-600">{value.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How to get connected -->
  <section class="bg-brand-900 py-20 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold sm:text-4xl">How to Get Connected</h2>
        <p class="mt-4 text-steel-200">From choosing a package to getting online — in four simple steps.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          buySteps.map((step, i) => (
            <div>
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-500 text-lg font-extrabold">
                {i + 1}
              </div>
              <h3 class="mt-4 text-base font-bold">{step.title}</h3>
              <p class="mt-2 text-sm text-steel-200">{step.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Field work gallery -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-extrabold text-steel-900 sm:text-4xl">
            Professional installation, wherever you are
          </h2>
          <p class="mt-5 text-steel-600">
            Our technicians handle every rollout with care — from erecting poles to configuring
            your home connection — so you get a reliable signal from day one.
          </p>
          <a
            href="/about"
            class="mt-8 inline-block rounded-full bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white hover:bg-brand-700"
          >
            More About Us
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <Image
            src={installTeam}
            alt="Tidco Networks installation team erecting a pole"
            width={600}
            height={600}
            class="h-56 w-full rounded-2xl object-cover sm:col-span-2"
          />
          <Image
            src={fieldConstruction}
            alt="Tidco Networks field construction site"
            width={400}
            height={533}
            class="h-48 w-full rounded-2xl object-cover"
          />
          <Image
            src={fieldTech}
            alt="Tidco Networks field technician on site"
            width={400}
            height={521}
            class="h-48 w-full rounded-2xl object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Coverage teaser -->
  <section class="bg-steel-950 py-20 text-white">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <h2 class="text-3xl font-extrabold sm:text-4xl">Connecting cities across the North</h2>
        <p class="mt-5 text-steel-300">
          Proudly based in Garissa, with our reliable network reaching communities across North
          Eastern Kenya.
        </p>
        <ul class="mt-8 grid grid-cols-2 gap-3">
          {
            coverageAreas.map((area) => (
              <li class="rounded-xl bg-white/5 px-4 py-3 text-sm font-semibold ring-1 ring-inset ring-white/10">
                {area.name}
                {area.note && <span class="ml-2 text-xs font-normal text-brand-300">{area.note}</span>}
              </li>
            ))
          }
        </ul>
        <a href="/coverage" class="mt-8 inline-block text-sm font-semibold text-brand-300 hover:text-brand-200">
          See our full coverage &rarr;
        </a>
      </div>
      <Image
        src={coverageGraphic}
        alt="Map illustrating Tidco Networks coverage across Wajir, Mandera, Garissa and Marsabit"
        width={1600}
        height={1361}
        class="w-full rounded-2xl"
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-600 py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl">Ready to get connected?</h2>
      <p class="mt-4 text-brand-100">
        Talk to our team today and get online with the most affordable network around.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-white px-8 py-4 text-base font-semibold text-brand-700 hover:bg-brand-50"
        >
          Chat on WhatsApp
        </a>
        <a
          href={telLink}
          class="rounded-full border border-white/40 px-8 py-4 text-base font-semibold text-white hover:bg-white/10"
        >
          Call 0723 100 023
        </a>
      </div>
    </div>
  </section>
</Layout>
