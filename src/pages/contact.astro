---
import Layout from "../layouts/Layout.astro";
import { site, whatsappLink, telLink, emailLink } from "../data/site";

const contactCards = [
  {
    label: "Call Us",
    value: site.phone,
    href: telLink,
    cta: "Call now",
  },
  {
    label: "WhatsApp",
    value: site.phone,
    href: whatsappLink,
    cta: "Start a chat",
  },
  {
    label: "Email",
    value: site.email,
    href: emailLink,
    cta: "Send an email",
  },
];
---

<Layout title="Contact Us">
  <section class="bg-brand-950 py-20 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold sm:text-5xl">Get In Touch</h1>
      <p class="mt-5 text-lg text-steel-200">
        Questions about coverage, packages, or your account? Our team is ready to help.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {
          contactCards.map((card) => (
            <a
              href={card.href}
              target={card.href.startsWith("http") ? "_blank" : undefined}
              rel={card.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="flex flex-col items-center rounded-2xl border border-steel-200 p-8 text-center transition-colors hover:border-brand-300 hover:bg-brand-50"
            >
              <p class="text-sm font-semibold uppercase tracking-wide text-steel-500">{card.label}</p>
              <p class="mt-2 text-lg font-bold text-steel-900">{card.value}</p>
              <span class="mt-4 text-sm font-semibold text-brand-600">{card.cta} &rarr;</span>
            </a>
          ))
        }
      </div>

      <div class="mt-16 rounded-2xl bg-steel-50 p-8">
        <h2 class="text-xl font-bold text-steel-900">Paying your bill?</h2>
        <p class="mt-3 text-sm text-steel-600">
          Use Lipa na M-Pesa, Paybill <span class="font-bold text-brand-700">{site.paybill}</span>,
          with your Tidco account number as the account reference.
        </p>
        <p class="mt-3 rounded-xl bg-brand-50 p-4 text-sm font-medium text-brand-800">
          Our staff will never ask you for money directly — all payments go through this Paybill
          only.
        </p>
      </div>

      <div class="mt-10 text-center text-sm text-steel-500">
        Prefer to talk it through? Reach us on WhatsApp for the fastest response.
      </div>
    </div>
  </section>
</Layout>
