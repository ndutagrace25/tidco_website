---
import Layout from "../layouts/Layout.astro";
import PackageCard from "../components/PackageCard.astro";
import { packages, billingNotes, refundNotes, whatsappLink, site } from "../data/site";
---

<Layout title="Packages & Pricing">
  <section class="bg-brand-950 py-20 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold sm:text-5xl">Packages & Pricing</h1>
      <p class="mt-5 text-lg text-steel-200">
        Simple, unlimited home internet — no data caps, no surprise charges.
      </p>
    </div>
  </section>

  <section class="bg-steel-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {packages.map((pkg) => <PackageCard pkg={pkg} />)}
      </div>
      <p class="mt-8 text-center text-sm text-steel-500">
        Want to upgrade or downgrade later? Just pay for the package you'd like when you renew — that's it.
      </p>
    </div>
  </section>

  <!-- Business / Fiber -->
  <section class="bg-brand-900 py-20 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-300">Tidco Fiber</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Instant collaboration for your business</h2>
          <p class="mt-5 text-steel-200">
            Video calls, cloud tools, and multi-device offices need more than a home plan. Talk to
            us about a dedicated business or fiber connection built around how your team works.
          </p>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-block rounded-full bg-white px-8 py-3.5 text-sm font-semibold text-brand-700 hover:bg-brand-50"
          >
            Ask About Business Fiber
          </a>
        </div>
        <ul class="space-y-4">
          {
            [
              "Fixed site internet for offices and campuses",
              "Bespoke connectivity for your business needs",
              "Priority support for business accounts",
            ].map((item) => (
              <li class="flex items-start gap-3 rounded-xl bg-white/5 p-4 ring-1 ring-inset ring-white/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-steel-100">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Billing & Payment -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-2xl font-extrabold text-steel-900">Billing</h2>
          <ul class="mt-6 space-y-4">
            {
              billingNotes.map((note) => (
                <li class="flex items-start gap-3 text-sm text-steel-600">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6M9 8h6M5 5h14a1 1 0 011 1v12a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1z" />
                  </svg>
                  {note}
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="text-2xl font-extrabold text-steel-900">Payment</h2>
          <div class="mt-6 rounded-2xl border border-steel-200 bg-steel-50 p-6">
            <p class="text-sm font-semibold text-steel-500">Lipa na M-Pesa</p>
            <p class="mt-1 text-sm text-steel-500">Paybill Number</p>
            <p class="text-3xl font-extrabold tracking-wide text-brand-700">{site.paybill}</p>
            <p class="mt-3 text-sm text-steel-600">Account Number: your Tidco customer account number</p>
          </div>
          <p class="mt-4 rounded-xl bg-brand-50 p-4 text-sm font-medium text-brand-800">
            Note: Our staff will never ask you for money directly. All payments are made only to
            our official Paybill above.
          </p>
        </div>
      </div>

      <div class="mt-16">
        <h2 class="text-2xl font-extrabold text-steel-900">Refund Policy</h2>
        <ul class="mt-6 space-y-4">
          {
            refundNotes.map((note) => (
              <li class="flex items-start gap-3 text-sm text-steel-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {note}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>
